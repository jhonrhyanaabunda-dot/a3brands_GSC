# ---------------------------------------------------------------------------
# A3 Brands GSC Intelligence Platform — environment variables
# Copy this file to .env.local for development, .env.production for prod.
# ---------------------------------------------------------------------------

# Database — Postgres connection string (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/a3brands?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/a3brands?schema=public"

# NextAuth (Auth.js v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-strong-random-string"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional — leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Search Console API (server-side reporting)
GSC_SERVICE_ACCOUNT_EMAIL=""
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Google PageSpeed Insights API key — used as fallback when our direct fetch
# is blocked by Cloudflare/Akamai (PSI fetches from Google's allowlisted IPs).
# Free at console.cloud.google.com → enable "PageSpeed Insights API" → create
# API key. Quota: 25,000 requests/day per key.
PAGESPEED_API_KEY=""

# Public site URL — used for canonical/OG tags and sitemap
NEXT_PUBLIC_SITE_URL="https://lonestarford.com"

# Feature flags
NEXT_PUBLIC_ENABLE_AI_INSIGHTS="true"
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
