// A3 Brands GSC Intelligence Platform - Prisma schema
// Enterprise-grade automotive SEO analytics

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------------------
// Enums
// -------------------------------------------------------------------------

enum Role {
  ADMIN
  DEALER_GROUP
  MARKETING_DIRECTOR
  GENERAL_MANAGER
}

enum DealershipTier {
  FLAGSHIP
  STANDARD
  SATELLITE
}

enum Brand {
  FORD
  CHEVROLET
  TOYOTA
  HONDA
  NISSAN
  HYUNDAI
  KIA
  MAZDA
  SUBARU
  VOLKSWAGEN
  BMW
  MERCEDES
  AUDI
  LEXUS
  ACURA
  INFINITI
  CADILLAC
  GMC
  RAM
  JEEP
  CHRYSLER
  DODGE
  PORSCHE
  VOLVO
  LANDROVER
  JAGUAR
  TESLA
  USED
  OTHER
}

enum InsightPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum InsightCategory {
  TECHNICAL
  CONTENT
  LOCAL_SEO
  COMPETITIVE
  KEYWORD
  SCHEMA
  PERFORMANCE
  INVENTORY
  SERVICE_PAGE
  GOOGLE_BUSINESS
}

enum InsightStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum KeywordIntent {
  BRAND
  COMMERCIAL
  TRANSACTIONAL
  INFORMATIONAL
  LOCAL
  INVENTORY
  SERVICE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  CLOSED_WON
  CLOSED_LOST
}

enum LeadSource {
  WEBSITE_FORM
  GSC_SCAN
  DEMO_REQUEST
  REFERRAL
  PARTNER
  OUTBOUND
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  CRITICAL
  REPORT_READY
  AI_INSIGHT
  COMPETITOR_ALERT
  RANKING_DROP
  RANKING_GAIN
}

enum ReportType {
  WEEKLY_EXECUTIVE
  MONTHLY_FULL
  GSC_AUDIT
  LOCAL_SEO_AUDIT
  COMPETITOR_BENCHMARK
  KPI_SNAPSHOT
  ROI_PROJECTION
}

enum ReportStatus {
  GENERATING
  READY
  FAILED
}

// -------------------------------------------------------------------------
// Auth.js v5 - required tables
// -------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role     @default(GENERAL_MANAGER)
  title         String?  // "Principal Dealer", "GM", etc.
  phone         String?

  dealerGroupId String?
  dealerGroup   DealerGroup? @relation(fields: [dealerGroupId], references: [id], onDelete: SetNull)

  dealerships   DealershipMember[]
  accounts      Account[]
  sessions      Session[]

  createdLeads      Lead[]         @relation("LeadCreator")
  assignedLeads     Lead[]         @relation("LeadOwner")
  notifications     Notification[]
  reportsRequested  SEOReport[]    @relation("ReportRequester")
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  @@index([role])
  @@index([dealerGroupId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------------------------
// Org structure - dealer groups & dealerships
// -------------------------------------------------------------------------

model DealerGroup {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  websiteUrl  String?
  marketArea  String?  // e.g. "Dallas-Fort Worth Metroplex"
  principalDealerName String?
  contactEmail String?
  contactPhone String?

  users        User[]
  dealerships  Dealership[]
  leads        Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dealership {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  brand         Brand
  tier          DealershipTier @default(STANDARD)
  websiteUrl    String
  gbpUrl        String?        // Google Business Profile URL
  gscPropertyId String?        // Search Console property
  ga4PropertyId String?

  // Location
  addressLine1 String?
  city         String
  state        String
  postalCode   String?
  country      String  @default("US")
  latitude     Float?
  longitude    Float?
  marketRadiusMiles Int @default(25)

  dealerGroupId String?
  dealerGroup   DealerGroup? @relation(fields: [dealerGroupId], references: [id], onDelete: SetNull)

  members      DealershipMember[]
  reports      SEOReport[]
  keywords     Keyword[]
  competitors  Competitor[]
  gscMetrics   GSCMetric[]
  insights     AIInsight[]
  leads        Lead[]
  localRankings LocalRanking[]
  technicalIssues TechnicalIssue[]
  reviews      ReviewSnapshot[]

  // Scorecards (denormalized, refreshed nightly)
  seoHealthScore       Int?
  leadOpportunityScore Int?
  localVisibilityScore Int?
  competitorRank       Int?
  lastScannedAt        DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([city, state])
  @@index([dealerGroupId])
}

model DealershipMember {
  id           String @id @default(cuid())
  userId       String
  dealershipId String
  role         Role   @default(GENERAL_MANAGER)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, dealershipId])
  @@index([dealershipId])
}

// -------------------------------------------------------------------------
// GSC metrics - time-series of clicks/impressions/CTR/position
// -------------------------------------------------------------------------

model GSCMetric {
  id            String   @id @default(cuid())
  dealershipId  String
  date          DateTime @db.Date
  device        String?  // DESKTOP | MOBILE | TABLET
  country       String?
  clicks        Int      @default(0)
  impressions   Int      @default(0)
  ctr           Float    @default(0)  // 0-100
  position      Float    @default(0)

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@unique([dealershipId, date, device, country])
  @@index([dealershipId, date])
}

// -------------------------------------------------------------------------
// Keywords
// -------------------------------------------------------------------------

model Keyword {
  id            String         @id @default(cuid())
  dealershipId  String
  query         String
  intent        KeywordIntent  @default(COMMERCIAL)
  isBranded     Boolean        @default(false)
  searchVolume  Int            @default(0)
  difficulty    Int            @default(0) // 0-100
  cpcCents      Int            @default(0)
  currentPosition Float        @default(0)
  previousPosition Float?
  bestPosition  Float?
  clicks        Int            @default(0)
  impressions   Int            @default(0)
  ctr           Float          @default(0)
  url           String?        // landing URL ranking for this query
  tags          String[]       @default([])

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  capturedAt DateTime @default(now())

  @@index([dealershipId])
  @@index([dealershipId, currentPosition])
  @@index([query])
}

// -------------------------------------------------------------------------
// Competitors
// -------------------------------------------------------------------------

model Competitor {
  id            String  @id @default(cuid())
  dealershipId  String
  name          String
  domain        String
  brand         Brand?
  city          String?
  state         String?
  distanceMiles Float?

  // Snapshot metrics (refreshed nightly)
  visibilityScore Int @default(0)  // 0-100
  sharedKeywords  Int @default(0)
  outrankedBy     Int @default(0)
  averagePosition Float @default(0)
  estimatedTraffic Int @default(0)

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealershipId, domain])
  @@index([dealershipId])
}

// -------------------------------------------------------------------------
// AI Insights / Recommendations
// -------------------------------------------------------------------------

model AIInsight {
  id            String           @id @default(cuid())
  dealershipId  String
  title         String
  summary       String           @db.Text
  rationale     String?          @db.Text
  category      InsightCategory
  priority      InsightPriority  @default(MEDIUM)
  status        InsightStatus    @default(NEW)

  estimatedClicksGain      Int?
  estimatedRevenueGainUsd  Int?
  effortHours              Int?
  confidence               Float?  // 0-1

  actions       Json?  // [{label, href, kind}]
  evidence      Json?  // structured evidence

  resolvedAt    DateTime?
  resolvedBy    String?

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealershipId, priority])
  @@index([dealershipId, status])
  @@index([category])
}

// -------------------------------------------------------------------------
// Reports
// -------------------------------------------------------------------------

model SEOReport {
  id           String       @id @default(cuid())
  dealershipId String
  type         ReportType
  status       ReportStatus @default(GENERATING)
  title        String
  periodStart  DateTime
  periodEnd    DateTime
  pdfUrl       String?
  summary      String?      @db.Text
  payload      Json?

  requestedById String?
  requestedBy   User?    @relation("ReportRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([dealershipId])
  @@index([type])
}

// -------------------------------------------------------------------------
// Local SEO - map pack, rankings, reviews
// -------------------------------------------------------------------------

model LocalRanking {
  id           String   @id @default(cuid())
  dealershipId String
  query        String
  city         String
  state        String
  position     Int      // map pack position 1-20 (1-3 = pack)
  inMapPack    Boolean  @default(false)
  gridLat      Float?
  gridLng      Float?
  capturedAt   DateTime @default(now())

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([dealershipId, capturedAt])
  @@index([query])
}

model ReviewSnapshot {
  id            String   @id @default(cuid())
  dealershipId  String
  totalReviews  Int      @default(0)
  averageRating Float    @default(0)
  newReviews30d Int      @default(0)
  responseRate  Float    @default(0)
  sentimentPositive Float @default(0)
  sentimentNeutral  Float @default(0)
  sentimentNegative Float @default(0)
  capturedAt    DateTime @default(now())

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([dealershipId, capturedAt])
}

// -------------------------------------------------------------------------
// Technical SEO issues (from GSC analyzer)
// -------------------------------------------------------------------------

model TechnicalIssue {
  id           String          @id @default(cuid())
  dealershipId String
  url          String
  title        String
  description  String          @db.Text
  category     InsightCategory
  severity     InsightPriority @default(MEDIUM)
  resolved     Boolean         @default(false)

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([dealershipId, resolved])
}

// -------------------------------------------------------------------------
// Lead generation
// -------------------------------------------------------------------------

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  websiteUrl  String?
  role        String?
  message     String?    @db.Text
  source      LeadSource @default(WEBSITE_FORM)
  status      LeadStatus @default(NEW)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  dealerGroupId String?
  dealerGroup   DealerGroup? @relation(fields: [dealerGroupId], references: [id], onDelete: SetNull)

  dealershipId  String?
  dealership    Dealership?  @relation(fields: [dealershipId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  scanScore      Int?    // captured at intake when source=GSC_SCAN
  estimatedValue Int?    // USD

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([dealershipId])
}

// -------------------------------------------------------------------------
// Notifications
// -------------------------------------------------------------------------

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  body    String?          @db.Text
  href    String?
  read    Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, read])
}

// -------------------------------------------------------------------------
// Audit log
// -------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
